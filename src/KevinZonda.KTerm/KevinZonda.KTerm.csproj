<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KevinZonda.KTerm</RootNamespace>
    <AssemblyName>KevinZonda.KTerm</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <WebProjectDir>$(MSBuildProjectDirectory)\..\KevinZonda.KTerm.Web</WebProjectDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4181-prerelease" />
  </ItemGroup>

  <!-- Passthrough ConPTY host (from Windows Terminal, MIT), embedded into the
       assembly and extracted on first use so single-file publish stays single.
       When the resource is absent, sessions fall back to the inbox conhost. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\openconsole\OpenConsole.exe')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\..\tools\openconsole\OpenConsole.exe">
      <LogicalName>KTerm.Binaries/OpenConsole.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="BuildWebAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(WebProjectDir)" Command="pnpm install --frozen-lockfile" Condition="!Exists('$(WebProjectDir)\node_modules\.pnpm\lock.yaml')" />
    <Exec WorkingDirectory="$(WebProjectDir)" Command="pnpm run build" />
    <ItemGroup>
      <_WebAsset Include="$(WebProjectDir)\dist\**\*" />
      <EmbeddedResource Include="@(_WebAsset)">
        <LogicalName>KTerm.WebAssets/%(_WebAsset.RecursiveDir)%(_WebAsset.Filename)%(_WebAsset.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
