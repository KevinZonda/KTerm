+namespace
+{
+    std::atomic<uint64_t> g_conptyOutputSubmits{ 0 };
+}
+
+uint64_t VirtualTerminal::ConptyOutputSubmitCount() noexcept
+{
+    return g_conptyOutputSubmits.load(std::memory_order_relaxed);
+}
+
+void VirtualTerminal::NoteConptyOutputSubmitted() noexcept
+{
+    g_conptyOutputSubmits.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Method Description:
+// - Emits one full-viewport repaint frame to the terminal client. This is
+//   meant to be called after a ConPTY resize: ResizeWithReflow re-layouts our
+//   copy of the buffer, but no VT output is generated for the resize itself,
+//   so a terminal client that cannot replicate conhost's reflow (e.g. any
+//   client other than Windows Terminal, which shares the TextBuffer code)
+//   diverges permanently from our buffer and leaves stale cells behind.
+// - The frame repaints whatever buffer is currently active. The alt buffer is
+//   not reflowed on resize (GH#3493) and alt-screen apps usually repaint
+//   themselves when they receive SIGWINCH, but a correctly addressed repaint
+//   frame is harmless there too, so we don't special-case it.
+// - Rows are written in full and addressed with absolute CUPs relative to the
+//   visible viewport, because the viewport origin may be non-zero after a
+//   height shrink. WriteInfos emits SGR on attribute run boundaries and takes
+//   care of wide glyphs and control characters.
+// - The cursor is restored with a final absolute CUP to the buffer cursor's
+//   viewport-relative position, rather than DECSC/DECRC: the terminal's
+//   pre-frame cursor position is exactly what may have diverged. The existing
+//   DSR/CPR resync (ConptyCursorPositionMayBeWrong, GH#18725) remains as a
+//   fallback in case the client still disagrees.
+// Arguments:
+// - <none> (the console lock must be held by the caller)
+// Return Value:
+// - <none>
+void VirtualTerminal::EmitViewportRepaint() noexcept
+try
+{
+    auto& gci = ServiceLocator::LocateGlobals().getConsoleInformation();
+    auto& screenInfo = gci.GetActiveOutputBuffer();
+    auto writer = gci.GetVtWriterForBuffer(&screenInfo);
+    if (!writer)
+    {
+        return;
+    }
+
+    const auto& viewport = screenInfo.GetViewport();
+    const auto width = viewport.Width();
+    const auto height = viewport.Height();
+    if (width <= 0 || height <= 0)
+    {
+        return;
+    }
+
+    const auto area = gsl::narrow_cast<size_t>(width) * gsl::narrow_cast<size_t>(height);
+    til::small_vector<CHAR_INFO, 1024> infos;
+    infos.resize(area, CHAR_INFO{ L' ', FOREGROUND_BLUE | FOREGROUND_GREEN | FOREGROUND_RED });
+
+    Viewport read;
+    LOG_IF_FAILED(ReadConsoleOutputWImplHelper(screenInfo, infos, viewport, read));
+
+    for (til::CoordType i = 0; i < height; i++)
+    {
+        const auto row = std::span<const CHAR_INFO>{ infos.begin() + i * width, static_cast<size_t>(width) };
+
+        // A fully-blank row gets an erase-to-EOL with default attributes
+        // instead of a full-width write. The buffer legitimately accumulates
+        // colored-blank filler rows when a resize reflows BCE output
+        // (progress bars etc.); dumping those verbatim floods the terminal
+        // with stale background color that no later output ever clears.
+        // Erasing trades that for a brief blank, which the app's next paint
+        // fills back in.
+        const auto blank = std::all_of(row.begin(), row.end(), [](const CHAR_INFO& ci) {
+            return ci.Char.UnicodeChar == L' ' &&
+                   WI_IsAnyFlagClear(ci.Attributes, COMMON_LVB_LEADING_BYTE | COMMON_LVB_TRAILING_BYTE);
+        });
+        if (blank)
+        {
+            writer.WriteCUP({ 0, i });
+            writer.WriteUTF8("\x1b[0m\x1b[K");
+            continue;
+        }
+
+        writer.WriteInfos({ 0, i }, row);
+    }
+
+    // Restore the attributes and cursor position the application expects.
+    writer.WriteAttributes(screenInfo.GetAttributes());
+    const auto& textBuffer = screenInfo.GetTextBuffer();
+    const auto cursor = textBuffer.GetCursor().GetPosition();
+    writer.WriteCUP({ std::clamp<til::CoordType>(cursor.x - viewport.Left(), 0, width - 1),
+                      std::clamp<til::CoordType>(cursor.y - viewport.Top(), 0, height - 1) });
+
+    writer.Submit();
+}
+CATCH_LOG()
