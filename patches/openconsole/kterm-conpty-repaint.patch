+
+// Method Description:
+// - Drains ResizeWindow messages that are already queued in the signal pipe,
+//   keeping only the last one. Only consumes a queued message once a complete
+//   one (id + payload) is available, and never touches other message types.
+// Arguments:
+// - data - The resize message to coalesce into; updated in place.
+// Return Value:
+// - <none>
+void PtySignalInputThread::_DrainPendingResizes(ResizeWindowData& data)
+{
+    struct
+    {
+        PtySignal signal;
+        ResizeWindowData size;
+    } msg;
+
+    while (_hFile)
+    {
+        DWORD available = 0;
+        if (!PeekNamedPipe(_hFile.get(), nullptr, 0, nullptr, &available, nullptr) || available < sizeof(msg))
+        {
+            break;
+        }
+
+        DWORD peeked = 0;
+        if (!PeekNamedPipe(_hFile.get(), &msg, sizeof(msg), &peeked, nullptr, nullptr) || peeked != sizeof(msg) || msg.signal != PtySignal::ResizeWindow)
+        {
+            break;
+        }
+
+        if (!_GetData(&msg, sizeof(msg)))
+        {
+            break;
+        }
+
+        data = msg.size;
+    }
 }
 
