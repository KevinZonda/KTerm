Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\KevinZondaTerminal]
@="Open in KTerm"
"Icon"="C:\\Tools\\Bin\\zt.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\KevinZondaTerminal\command]
@="\"C:\\Tools\\Bin\\zt.exe\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\KevinZondaTerminal]
@="Open in KTerm"
"Icon"="C:\\Tools\\Bin\\zt.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\KevinZondaTerminal\command]
@="\"C:\\Tools\\Bin\\zt.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Drive\shell\KevinZondaTerminal]
@="Open in KTerm"
"Icon"="C:\\Tools\\Bin\\zt.exe"

[HKEY_CURRENT_USER\Software\Classes\Drive\shell\KevinZondaTerminal\command]
@="\"C:\\Tools\\Bin\\zt.exe\" \"%1\""
